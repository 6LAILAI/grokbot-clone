# Copy to .env and fill in. Never commit .env.

# Required for the shopping assistant (Grok text API)
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Required for signed sessions
SESSION_SECRET=         # openssl rand -hex 32

# Ecommerce mode (default on). Set to 0 to restore classic Grokbot teammate prompt.
ECOMMERCE_MODE=1

# Optional: Composio for Google sign-in + connected apps. Leave blank to use DEV_LOGIN only.
COMPOSIO_API_KEY=

# Optional: Orgo cloud computer. Shopping tools work without it.
ORGO_API_KEY=
ORGO_WORKSPACE_ID=
ORGO_RAM_GB=8
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24

PORT=8787
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:8787
DEV_LOGIN=1             # 1 enables POST /api/auth/dev (local testing only)

# Voice (optional; defaults shown). Calls use XAI_API_KEY via short-lived client secrets.
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0
